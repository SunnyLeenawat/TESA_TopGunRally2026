# Copy this file to starter/.env and fill in the values from the organizer.
# Never commit starter/.env.
#
# The starter also accepts the practice-kit names MARKET_BASE_URL,
# MARKET_API_KEY and LLM_PROVIDER; its own names below take precedence.

# --- market ---------------------------------------------------------------
MARKET_URL=http://127.0.0.1:8000
# Team key from the organizer. Must start with sk-T and must NOT be sk-T00-...
TEAM_KEY=sk-T00-put-your-team-key-here

# --- LLM (organizer gateway only during the competition) ------------------
# 1 = use the gateway, 0 = rules only. If the gateway fails the agent still
# plays with the rules; it never switches to another provider.
USE_LLM=1
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=event-llm
# Empty = reuse TEAM_KEY (the gateway uses the same key as the market).
LLM_API_KEY=
LLM_TIMEOUT=60
# 0 = reasoning_effort "none" (recommended), 1 = "medium" (slower).
LLM_THINKING=0
LLM_MAX_TOKENS=1500

# --- behaviour ------------------------------------------------------------
# GET /v1/state interval in seconds (clamped to 1-5).
POLL_SECONDS=2
# Sell slightly more than the even share of the remaining stock per round.
PACE=1.3
# Safety distance from the buyer's limits (sample vs real-lot noise).
SPEC_MARGIN_DEFECT=0.15
SPEC_MARGIN_MOISTURE=0.10
SPEC_MARGIN_SCREEN=0.0
# Maximum candidate pairs sent to the LLM prompt.
MAX_CANDIDATES=40
# Where decisions.jsonl and memory-*.json are written.
LOG_DIR=starter/logs
