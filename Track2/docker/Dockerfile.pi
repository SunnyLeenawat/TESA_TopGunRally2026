# Runtime image. amd64 on this host, arm64 on the Pi. No PyTorch.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONPATH=/app/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/pi.txt /tmp/requirements.pi.txt
RUN pip install --no-cache-dir -r /tmp/requirements.pi.txt \
    && python -c "import numpy, cv2, ncnn, yaml; print('pi imports ok')"

COPY config /app/config
COPY src /app/src

CMD ["python", "-m", "coffee.hello"]
